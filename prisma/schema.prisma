generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("customer")
  phone         String?
  avatar        String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Password Reset Tokens ──────────────────────────────────────────────────
// Single-use tokens emailed to users when they click "Forgot password?".
// Each token is valid for 1 hour, then auto-expires.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  price        Float
  comparePrice Float?
  categorySlug String
  images       String           @default("[]")
  benefits     String           @default("[]")
  ingredients  String           @default("")
  howToUse     String           @default("")
  stock        Int              @default(0)
  featured     Boolean          @default(false)
  newArrival   Boolean          @default(false)
  bestSeller   Boolean          @default(false)
  freeShipping Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  variants     ProductVariant[]
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  sku          String?
  price        Float
  comparePrice Float?
  stock        Int      @default(0)
  weight       String?
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id              String   @id @default(cuid())
  userId          String?
  items           String   @default("[]")
  subtotal        Float
  discount        Float    @default(0)
  shippingRate    Float    @default(0)
  shippingZoneCode String?
  promotionId     String?
  couponCode      String?
  total           Float
  status          String   @default("pending")
  customerName    String
  email           String
  phone           String?
  address         String
  city            String
  state           String?
  zipCode         String?
  country         String   @default("United States")
  paymentMethod   String   @default("clover")
  paymentStatus   String   @default("pending")
  cloverCheckoutId String?
  cloverSessionId  String?
  cloverPaymentId  String?
  paymentDetails  String?   @default("{}")
  invoiceNumber   String?
  invoiceSent     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PromoBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  ctaText   String?
  ctaLink   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  mediaUrl  String
  mediaType String   @default("image")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String   @default("")
  subtitle    String?
  mediaUrl    String
  mediaType   String   @default("image")
  active      Boolean  @default(true)
  order       Int      @default(0)
  overlayDark Float    @default(0.5)
  kenBurns    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String
  url       String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnnouncementItem {
  id        String   @id @default(cuid())
  text      String
  icon      String   @default("none")
  separator String   @default("✦")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transformation {
  id        String   @id @default(cuid())
  name      String
  duration  String
  result    String
  beforeImg String
  afterImg  String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspirationItem {
  id        String   @id @default(cuid())
  label     String
  tip       String
  image     String
  icon      String   @default("Sparkles")
  color     String   @default("from-gold/80")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Key-Value Settings Store (persists across sandbox resets) ───────────────
// Used as a DB-backed fallback for environment variables (especially Clover
// payment credentials) so that when the sandbox wipes .env.local, the app
// can still read credentials from the PostgreSQL database (which persists).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Shipping Zones ─────────────────────────────────────────────────────────
// Admin-managed shipping rates per region. The checkout page reads these
// to calculate shipping cost based on the customer's country/region.
model ShippingZone {
  id          String   @id @default(cuid())
  name        String                         // "United States", "Africa", etc.
  code        String   @unique               // "US", "CA", "AF", etc.
  flag        String   @default("")          // emoji flag, e.g. "🇺🇸"
  rate        Float                          // flat shipping rate in USD
  estimatedDays String @default("")          // "3-5 business days"
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Promotions / Coupons ───────────────────────────────────────────────────
// Admin-managed discount codes. The checkout page validates a coupon code
// against this table and applies the discount if all eligibility rules pass.
model Promotion {
  id                 String   @id @default(cuid())
  name               String                          // "Black Friday 2026"
  description        String?
  type               String   @default("percentage") // "percentage" | "fixed" | "shipping"
  discount           Float                            // percentage (0-100) or fixed USD amount
  couponCode         String   @unique                // "BLACKFRI40"
  minimumOrder       Float    @default(0)            // minimum subtotal in USD
  eligibleProducts   String   @default("[]")         // JSON array of product IDs (empty = all)
  eligibleCategories String   @default("[]")         // JSON array of category slugs (empty = all)
  freeShipping       Boolean  @default(false)        // if true, shipping cost is waived
  startDate          DateTime?
  endDate            DateTime?
  usageLimit         Int      @default(0)            // 0 = unlimited
  usedCount          Int      @default(0)
  status             String   @default("active")     // "active" | "scheduled" | "expired" | "disabled"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Ad Videos (replaces Inspiration Hub) ───────────────────────────────────
// Product ad videos shown on the homepage. Admin uploads via Cloudinary
// (or local disk fallback) and customers watch them inline.
model AdVideo {
  id          String   @id @default(cuid())
  title       String                                // "Vitamin C Serum Demo"
  description String?                               // optional caption
  videoUrl    String                                // Cloudinary or /uploads/... URL
  posterImage String?                               // optional thumbnail image URL
  productSlug String?                               // optional link to a product
  duration    String   @default("")                 // "0:45" — display only
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
