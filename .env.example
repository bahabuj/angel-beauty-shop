# ════════════════════════════════════════════════════════════════════════════
# Angelsbeauty — Production Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local (local dev) or set in Vercel dashboard (prod):
#   cp .env.example .env.local
#
# .env.local is gitignored and MUST NEVER be committed.
# ════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED — Supabase PostgreSQL ───────────────────────────────────────────
# Pooler (PgBouncer) — port 6543 — used at runtime by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statement_cache_size=0"

# Direct connection — port 5432 — used by Prisma for migrations ONLY
DIRECT_URL="postgresql://USER:PASSWORD@HOST.supabase.co:5432/postgres"

# Optional shadow database for `prisma migrate reset` (leave empty on free tier)
SHADOW_DATABASE_URL=""

# ─── REQUIRED — Auth ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.com"

# ─── REQUIRED — Cloudinary (image/video storage) ──────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── REQUIRED FOR PAYMENTS — Clover Ecommerce API ─────────────────────────────
CLOVER_ECOM_TOKEN=""
CLOVER_ECOM_MERCHANT_ID=""
CLOVER_ENVIRONMENT="production"
CLOVER_DEBUG="false"

# ─── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ─── Optional — Firebase (has hardcoded fallbacks in code) ────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
