# ════════════════════════════════════════════════════════════════════════════
# Angelsbeauty — Environment Variables Template
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is gitignored and MUST NEVER be committed.
# This .env.example file is committed and contains NO secret values.
#
# After editing .env.local, restart the dev server:
#   bun run dev
#
# Or use the Admin panel: Settings → Clover Payment Configuration
# (writes to .env.local atomically — never overwrites the file)
# ════════════════════════════════════════════════════════════════════════════


# ─── REQUIRED (app will not boot without these) ──────────────────────────────

# SQLite connection string. Prisma throws at runtime if missing.
DATABASE_URL="file:./db/custom.db"

# Signs NextAuth session JWTs + cookie auth tokens.
# Generate with:  openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"


# ─── REQUIRED FOR PAYMENTS (app runs but checkout fails without these) ───────
#
# Two paths are supported. Configure EITHER Path A OR Path B.
# Path A (Ecommerce API) is recommended for single-merchant stores.
# ─────────────────────────────────────────────────────────────────────────────

# ── Path A: Ecommerce API Private Token (RECOMMENDED) ────────────────────────
# Found in Clover Merchant Dashboard → Ecommerce → Ecommerce API Tokens.
# Use the PRIVATE token (not the public key) with HOSTED_CHECKOUT integration type.
CLOVER_ECOM_TOKEN=""
# Ecommerce merchant ID (shown on the same Ecommerce API Tokens page).
# This is DIFFERENT from the POS/Dashboard merchant ID.
CLOVER_ECOM_MERCHANT_ID=""

# ── Path B: OAuth (alternative — leave blank if using Path A) ────────────────
# OAuth access token obtained via the /oauth/callback flow.
CLOVER_ACCESS_TOKEN=""
# POS/Dashboard merchant ID (used as fallback if CLOVER_ECOM_MERCHANT_ID is empty).
CLOVER_MERCHANT_ID=""
# Clover Developer App credentials (only needed for OAuth flow).
CLOVER_CLIENT_ID=""
CLOVER_CLIENT_SECRET=""


# ─── OPTIONAL (sensible defaults exist in code) ──────────────────────────────

# "sandbox" or "production". Defaults to "sandbox".
# Set to "production" ONLY when your Clover account is live and you've tested in sandbox.
CLOVER_ENVIRONMENT="sandbox"

# Set to "true" to enable verbose Clover API logging.
# NEVER enable in production — logs may contain card last4, auth codes, etc.
CLOVER_DEBUG="false"

# Server-side canonical site URL. Used for Clover redirect URLs, OAuth callbacks, webhooks.
# Takes precedence over NEXT_PUBLIC_SITE_URL.
# Falls back to request origin if unset.
SITE_URL=""

# Server-side Firebase project ID for ID-token verification.
# Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID, then a hardcoded project ID.
FIREBASE_PROJECT_ID=""


# ─── PUBLIC (NEXT_PUBLIC_ — exposed to browser bundle, safe to commit) ──────
#
# These have hardcoded fallbacks baked into the bundle, so the app runs even
# if unset. Override them here if you reconfigure Firebase or change the domain.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL for SEO canonical URLs, OG tags, JSON-LD.
# Defaults to https://angelsbeauty.com
NEXT_PUBLIC_SITE_URL="https://angelsbeauty.com"

# Firebase web app config (all values are public by design — they identify the
# project, they do not authenticate it).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
